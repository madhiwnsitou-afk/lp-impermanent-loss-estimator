{
  "name": "lp-impermanent-loss-estimator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "backtest": "node scripts/backtest.js",
    "capture": "node scripts/capture.js",
    "example": "node scripts/example.js",
    "build": "esbuild client/payment.js --bundle --format=esm --minify --outfile=public/payment.js",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "esbuild": "0.28.2",
    "express": "^5.1.0",
    "viem": "^2.38.0",
    "zod": "^4.1.0"
  },
  "license": "MIT"
}
