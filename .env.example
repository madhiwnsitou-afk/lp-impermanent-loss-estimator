# Local mode: loopback only, no payments. No private key is required by this server.
PORT=4021
RPC_URL=https://ethereum-rpc.publicnode.com
# For public production: NODE_ENV=production, an HTTPS domain, and these values:
# PAYMENT_RECIPIENT=your-own-EVM-public-address
# PAYMENT_NETWORK=eip155:84532
# FACILITATOR_URL=https://x402.org/facilitator
# PAYMENT_PRICE=$0.01
# Base mainnet is eip155:8453; use a facilitator that explicitly supports it.
